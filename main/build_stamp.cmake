# Writes the build stamp (main/CMakeLists.txt runs this on every build).
# Minute precision, and only rewrites when the text changes: two builds in
# the same minute recompile nothing, and the "Built on" in Settings > About
# never lags behind.
string(TIMESTAMP M5_WHEN "%Y-%m-%d %H:%M")
set(M5_TEXT "// Generated by main/build_stamp.cmake on every build - do not edit.\nconst char* const m5tabos_compiled = \"${M5_WHEN}\";\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" M5_PREV)
endif()
if(NOT "${M5_PREV}" STREQUAL "${M5_TEXT}")
  file(WRITE "${OUT}" "${M5_TEXT}")
endif()
