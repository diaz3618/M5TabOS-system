# Project target: without this, a fresh clone builds for the default ESP32.
CONFIG_IDF_TARGET="esp32p4"

# --- flash ---------------------------------------------------------------
# The Tab5 has 16 MB. The 2 MB default cannot fit an app with the display and radio.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Use a custom table instead of the IDF's "singleapp_large": it gives the app 1500K,
# and we were already using 68% of that space. See partitions.csv; NVS stays at the
# same address, so the user's preferences survive the change.
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- SILICON REVISION ----------------------------------------------------
# NOT stored here: P4 v1.x (the Tab5 units sold so far) and v3.x require
# DIFFERENT binaries, and each has its own file: sdkconfig.defaults.chip_v1 and
# sdkconfig.defaults.chip_v3. The root CMakeLists.txt chooses one (M5_CHIP,
# v1 by default); flash.sh reads the revision of the connected device and chooses
# automatically.

# --- PSRAM ---------------------------------------------------------------
# Required on the Tab5: the 720x1280 framebuffer does not fit in internal RAM.
CONFIG_SPIRAM=y
# HEX at 200 MHz; see the warning below about the fixed cost per burst
# (the DMA2D/cache section). Without this pinned here, a fresh clone that has
# never run menuconfig inherits the ESP-IDF default (HEX at 20 MHz), just one
# tenth of the bandwidth the DSI panel needs while DW-GDMA reads the PSRAM
# framebuffer, or it underruns. That is exactly what happened: repository
# factory builds always ran on a machine whose local sdkconfig had already been
# adjusted by hand (sdkconfig is intentionally not committed), so this had never
# been tested on a genuinely clean clone.
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# Large static buffers marked with EXT_RAM_BSS_ATTR go to PSRAM
# (the Mesh node table, log sink, monitor history, and so on); internal SRAM
# is the system's most heavily contested memory.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y


# --- file names on the card -----------------------------------------------
# WITHOUT THIS, FAT ACCEPTS ONLY 8.3 NAMES: eight characters before the dot.
# The IDF default is CONFIG_FATFS_LFN_NONE, with a deceptive result: the FOLDER
# is created, fopen silently fails, and you are left with an empty directory
# without knowing why. That is exactly what happened:
# "energy.csv" (7 characters) wrote all night, while "satellites.csv" (9) never
# created the file.
#
# In a system where each application chooses its own file names, requiring 8.3
# names is a permanent trap. LFN_HEAP puts the name buffer on the heap, which is
# the memory that remains available on the P4 with PSRAM.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128

# THE CARD NAME (volume label): the Files app shows the name the card has on the
# computer instead of "Card". Read-only (f_getlabel).
CONFIG_FATFS_USE_LABEL=y

# --- console -------------------------------------------------------------
# UART as primary and USB-Serial-JTAG as secondary (the P4 default).
# CONFIG_ESP_CONSOLE_UART_DEFAULT used to be selected. It was changed because
# the Tab5's USB-C port is the P4's NATIVE USB-Serial-JTAG (/dev/cu.usbmodem*),
# not a converter connected to UART0.
#
# With UART0 as the primary console, logs still arrived through the SECONDARY
# console, which the IDF Kconfig itself describes as OUTPUT ONLY
# (esp_system/Kconfig:312-315). But stdin remained stuck on UART0, on GPIOs
# 37/38, where nothing is connected: typing in the monitor went nowhere, and no
# terminal on earth could fix that.
#
# The Kconfig help says exactly this: "if you want input through the
# USB_SERIAL_JTAG port, please change the primary config to
# ESP_CONSOLE_USB_SERIAL_JTAG".
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# --- FreeRTOS ------------------------------------------------------------
# 1000 Hz tick: vTaskDelay gets 1 ms resolution instead of 10 ms.
CONFIG_FREERTOS_HZ=1000

# TWO NOTIFICATION SLOTS PER TASK. The interface wakes through slot 1
# (kernel/core.cpp, UI_AVISO_IDX) and leaves slot 0 for lower-level notification
# users (stream buffers, drivers). In an old sdkconfig this key is not added
# automatically: the code falls back to slot 0 and works as before. To get the
# separation, use 'idf.py menuconfig' (Component config > FreeRTOS > Kernel), or
# delete sdkconfig and build again.
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2

# --- power management ----------------------------------------------------
# STEP 1 (enabled): frequency DFS, WITHOUT light sleep.
# Unlocks esp_pm_configure(), which returned ESP_ERR_NOT_SUPPORTED in Arduino.
# From here, the CPU drops to min_freq_mhz when NOBODY holds a PM lock and rises
# to max_freq_mhz when someone holds ESP_PM_CPU_FREQ_MAX. This is not a load-
# measuring governor; it is deterministic and driven by locks acquired silently
# by the drivers. See tab5_power.hpp.
CONFIG_PM_ENABLE=y

# STEP 2 - automatic light sleep while idle. DO NOT enable it with step 1:
# this is where interaction risk with PSRAM and the DSI panel lives, and you want
# to know which step broke if something fails.
# Silicon reminder: PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP depends on
# !ESP32P4_SELECTS_REV_LESS_V3, so it DOES NOT exist on this chip. The CPU only
# stops its clock in light sleep; it is not powered down.
# CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Diagnostics for when the frequency does NOT drop: makes esp_pm_dump_locks()
# print who created each lock and how long it was held. This is the tool for
# finding out whether the C6 SDIO is keeping the clock high.
# CONFIG_PM_PROFILING=y


# --- task statistics -------------------------------------------------------
# Enable the "Tasks" app. Without the first option, TaskStatus_t's
# ulRunTimeCounter stays at zero and CPU usage cannot be calculated.
# GENERATE_RUN_TIME_STATS already selects USE_TRACE_FACILITY and
# USE_STATS_FORMATTING_FUNCTIONS automatically; there is no need to list both.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Adds the xCoreID field to TaskStatus_t. Depends on
# USE_STATS_FORMATTING_FUNCTIONS, which the option above already enabled.
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# The time counter is esp_timer in microseconds. At 32 bits it overflows after
# about 71 minutes and the statistics become garbage; at 64 bits, never.
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# --- optimization --------------------------------------------------------
# Equivalent to PlatformIO's "build_type = debug", which breaks the build with
# espidf. -Og keeps the code debuggable. Change to _PERF when measuring.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- main task ------------------------------------------------------------
# The 3584-byte default cannot handle M5.begin() (panel + touch + expanders).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- WiFi: SDIO to the ESP32-C6 ------------------------------------------
# The Tab5 has no radio on the P4. WiFi and BLE come from a nearby ESP32-C6 over
# SDIO.
#
# esp_hosted ALREADY PROVIDES A PRESET for this board, found by reading its
# Kconfig before hard-coding the six pins. It defines CLK 12, CMD 13,
# D0 11, D1 10, D2 9, D3 8, and reset 15, exactly matching the measurements
# on the board. Using the preset is better: if Espressif fixes something,
# the fix comes for free.
#
# With the reference-kit defaults (CMD 19, CLK 18, D0 14), esp_hosted reports
# "send_op_cond returned 0x107" and the board enters a boot loop.
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y

# esp_hosted installs an __attribute__((constructor)) that runs BEFORE
# app_main and starts a task (eh_init, priority 23) that performs eh_host_init()
# and eh_host_connect_to_slave(). This conflicts with the default-off power
# profile: app_main turns off WLAN_PWR_EN (the C6 power rail) around 2.1 s, while
# SDIO probing reaches the unpowered chip at 3.1 s ->
#   sdmmc_io_reset: unexpected return: 0x108   (ESP_ERR_TIMEOUT, about 15 times)
#   eh_sdio: ensure_slave_bus_ready failed: -1
# This is not a wrong pin or incompatible C6 firmware; it is a lack of power.
#
# With =n, WiFi starts only when tab5_wifi requests it, after enabling the rail
# and waiting for the C6 to boot. The Kconfig help itself recommends n for apps
# that need to choose when initialization occurs.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n

# L2 cache: 128 KB is the IDF default; the P4 supports 256 KB and 512 KB. We
# increased it to 256 KB because the system draws heavily into a framebuffer in
# PSRAM, and every cache hit avoids a PSRAM access.
#
# The cost is internal RAM: L2MEM is divided between cache and SRAM. There is
# ample room; boot's heap_init showed 384+99+18 KB free before the change.
#
# DO NOT increase it to 512 KB without measuring: in that range the IDF changes
# the cache line from 64 to 128 bytes (Kconfig.cache lines 26-27), and a larger
# line wastes bandwidth when access is scattered; performance may get worse.
CONFIG_CACHE_L2_CACHE_256KB=y

# --- peer_data channel with the C6 ----------------------------------------
# Opaque byte pipe between the P4 and C6 over Custom RPC. ESP-NOW communicates
# through it (esp_now does NOT link on the P4; it exists only on the C6 side),
# and the host uses it to confirm the link after flashing new coprocessor
# firmware, canceling the automatic rollback.
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y

# --- esp_hosted task stacks in PSRAM --------------------------------------
# All 6 esp_hosted tasks (sdio_rx_buf, sdio_read, sdio_write, sdio_process_rx,
# eh_rpc_tx, eh_rpc_rx) use the same 4 KB setting. Measured in the task report,
# four use less than 1 KB: about 24 KB of internal SRAM was reserved for about
# 8 KB of actual use. Lowering the setting is not viable (eh_rpc_rx uses about
# 2.7 KB and would lose headroom); moving the stacks is, without patching the
# component, which is what Espressif does in its P4 host examples.
# This is safe because none of them touches flash (peer_data callbacks only copy
# to queues), and SDIO uses its own DMA buffers, never the task stack.
# Cost: the monitor snapshot reads these stacks in the critical section; this
# was measured in the task report (snapshot/worst case) before and after.
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y

# --- WiFi buffers: THIS SIDE DECIDES, the C6 pays the cost -----------------
# The C6's esp_hosted calls esp_wifi_init with the fields received from here
# (get_merged_init_config: "always use value from host"). The CONFIG_ESP_WIFI_*
# values in c6/sdkconfig do not apply to buffers, BA, or CSI. The consumed RAM
# is the C6's (about 250 KB free at its boot); the P4 allocates none of this.
#
# Values from Espressif's performance table for P4 + C6 over 4-bit SDIO at
# 40 MHz (esp_hosted's docs/design/performance.md). The factory values
# (10/32/32, window 6) limited each A-MPDU aggregate sent by the router to six
# frames. IDF 5.5 has no consumer for TX_BA_WIN (the WiFi library uses its own
# internal value); it matches the table for consistency.
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_RX_BA_WIN=32

# --- BLUE FLICKER, CAUSE 1: the screen stops updating when flash is written --
#
# The DPI panel does not "push" the image: a DMA (DW-GDMA) reads the PSRAM
# framebuffer line by line forever. This DMA is NOT CIRCULAR; it finishes each
# frame and is RESTARTED by an interrupt:
#
#   mipi_dsi_dma_trans_done_cb (esp_lcd_panel_dpi.c:70)
#     dw_gdma_channel_use_link_list(chan, link_list);
#     dw_gdma_channel_enable_ctrl(chan, true);      <- 64 times per second
#
# If this interrupt is delayed, the panel FIFO runs dry and the frame turns BLUE.
#
# CONFIG_LCD_DSI_ISR_HANDLER_IN_IRAM already defaults to =y: the interrupt code
# lives in IRAM, so a cache miss cannot delay it. But THAT IS NOT ENOUGH. When
# someone writes flash—and nvs_commit() writes flash—the IDF calls
# spi_flash_disable_interrupts_caches_and_other_cpu(), which DISABLES the cache
# and, with it, every interrupt not registered as IRAM-safe. The DSI interrupt
# was not. Erasing a sector takes tens of milliseconds: two or three complete
# frames pass without anyone restarting the DMA.
#
# What writes NVS in this system: settings.cpp (brightness, WiFi, keyboard,
# Grove, screen timeout—the Settings app) and tab5_mesh (our node number). In
# other words, the flicker when leaving Settings was never a memory-bandwidth
# problem. This was the cause.
#
# CACHE_SAFE also selects DW_GDMA_ISR_IRAM_SAFE, which is the important half
# (the interrupt that restarts DMA belongs to DW-GDMA, not the DSI bridge). It
# costs a few KB of IRAM and nothing else: M5GFX registers no callback on the
# DPI panel, so there is nothing for the "callback must be in IRAM" check to
# reject.
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y

# --- ROBUSTNESS FINE-TUNING ------------------------------------

# STACK OVERFLOW, CAUGHT INSTANTLY, NOT AT THE NEXT CONTEXT SWITCH.
#
# The default (CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY, already enabled) only
# notices the overflow when the scheduler switches tasks. By then the damage
# has happened, and whatever remains on the stack may already have been
# overwritten by code that ran afterward. This uses the CPU's LAST hardware
# watchpoint to stop at the EXACT instant any of the last 32 bytes of the stack
# is overwritten, before the damage spreads.
#
# Cost: about 60 fewer usable stack bytes PER TASK (our existing headroom—the
# largest stack here is the 12288-byte console stack—absorbs this comfortably),
# and one fewer hardware watchpoint for anyone using JTAG/gdb. This project is
# debugged through its own console (see console.cpp), not JTAG, so the watchpoint
# is not needed for anything else.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# 128-BYTE L2 CACHE LINE—found while chasing the blue frame.
# Every cache miss/flush becomes a PSRAM burst the size of the line, and
# PSRAM (HEX, 200 MHz) pays a fixed command-plus-latency cost per burst. With
# 64 B, that fixed cost doubles for the same data: less useful CPU bandwidth and
# TWICE as many transactions competing with the panel DMA for the bus.
# Evidence that 128 is the expected value for this board:
#  - Espressif's P4 Arduino sdkconfig (including esp32p4_es, for revision < 3
#    chips like ours) uses 128;
#  - M5GFX aligns cache synchronization to 128 (Panel_FrameBufferBase.cpp,
#    Cache_WriteBack_Addr: addr & ~127u); it was written expecting 128.
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# IPC TASK STACKS (ipc0/ipc1). The system monitor (services/tab5_monitor) showed
# ipc0 with 448 B free out of 1024: it performs what the other core requests
# (interrupts, cache work, clock changes), and usage depends on the requester.
# 1536 provides real headroom; it costs 1 KB of SRAM across both cores.
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536

# Camera: the ISP pipeline controller handles automatic exposure and white
# balance (without it, the image is green and dark).
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# --- Bluetooth -------------------------------------------------
# The P4 HAS NO RADIO: the BLE controller belongs to the C6, and our C6 firmware
# already ships with it enabled (ESP_HOSTED_CP_FEAT_BT, HCI over VHCI; see
# c6/sdkconfig). This only starts the NimBLE STACK on the P4 and the esp_hosted
# bridge, which carries HCI packets over the same SDIO link as WiFi. None of
# this requires reflashing the C6.
#
# Central (the Tab5 connects to Meshtastic, not the reverse) is enabled and the
# peripheral role is disabled; only what is used starts. PIN pairing (required
# by Meshtastic) and the bond are stored in NVS, so the PIN is not requested on
# every restart.
#
# NimBLE memory goes to PSRAM: internal SRAM is the system's most contested
# resource, and BLE is not a real-time path here.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# --- Camera (SC202CS on MIPI-CSI) -----------------------------------------
# The Tab5 sensor. Without these options, esp_cam_sensor does not compile its
# driver and the Camera app cannot find any sensor.
CONFIG_CAMERA_SC202CS=y
CONFIG_CAMERA_SC202CS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
# Full sensor frame. The 1280x720 mode is a centered window (80% x 60% of the
# field of view), so the photo looked zoomed in.
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1600X1200_30FPS=y
CONFIG_CAMERA_SC202CS_MIPI_DEFAULT_FMT_RAW8_1600X1200_30FPS=y
CONFIG_CAMERA_SC202CS_DIG_GAIN_PRIORITY=y
CONFIG_CAM_CTLR_MIPI_CSI_ISR_CACHE_SAFE=y
CONFIG_CAM_CTRL_SPI_ENABLE=n

# --- panel DMA in IRAM -----------------------------------------------------
# The DW-GDMA functions used by the panel ISR stay in IRAM: with the cache
# disabled (while writing flash), they keep running and the screen does not
# flicker.
CONFIG_DW_GDMA_CTRL_FUNC_IN_IRAM=y
CONFIG_DW_GDMA_GETTER_FUNC_IN_IRAM=y
CONFIG_DW_GDMA_SETTER_FUNC_IN_IRAM=y

# --- internal RAM: what moves out of it ------------------------------------
# Internal SRAM (about 320 KB of heap) is the most contested resource: stacks,
# queues, and DMA buffers for the C6 SDIO and panel. See also main/linker.lf.
#
# mbedTLS in PSRAM. With INTERNAL, each TLS session (mqtts, https, or a network
# update of the C6) takes about 40 KB from internal RAM at once; the input buffer
# alone is 16 KB. MQTT is "mqtt://" today, but TLS support is compiled in, and
# enabling it someday must not bring down the rest of the system. The P4's
# hardware AES/SHA handles buffers in PSRAM (the driver copies through an
# internal bounce buffer when necessary).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
#
# sys_evt stack (the IDF default event loop). The WiFi event handler logs and
# performs RPC there, and pilhas-*.csv showed only 600 bytes free out of 2304,
# too close to the limit. This is not an optimization: it is the one place that
# NEEDS to grow.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
#
# Ordinary malloc() allocations up to 4 KB stay internal; larger ones go to
# PSRAM (the default was 16 KB). FreeRTOS stacks and objects do not pass through
# this setting (they explicitly request internal memory), and DMA users request
# MALLOC_CAP_DMA. Thus, the items moved are ordinary 4-to-16 KB buffers that
# occupied internal RAM without needing it. Check with the memory map (the <16K range
# of used memory).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- Camera: custom SC202CS calibration -----------------------------------
# Copy of esp_cam_sensor's sc202cs_default.json with ONE change: automatic
# exposure targets a lower brightness (target 62 -> 52, range 56..64 -> 46..54)
# and reacts sooner to blown highlights (high_threshold 239 -> 230,
# high_regions 3 -> 2). Reason: the P4 ISP applies white-balance gain and the
# color matrix (CCM) WITHOUT clipping excess first. In a white area that
# saturates the sensor, red and blue exceed 255 and the CCM's green row
# (-0.70 R + 2.08 G - 0.38 B) pulls green down, making white appear magenta.
# Lower exposure means fewer saturated pixels. To restore the factory setting:
# DEFAULT_IPA_JSON=y.
# The magenta correction itself is the protected matrix from the custom IPA
# (main/hal/tab5_camera_ipa.c); lower exposure only reduces the blown-out area.
# CONFIG_CAMERA_SC202CS_DEFAULT_IPA_JSON_CONFIGURATION_FILE is not set
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="main/hal/sc202cs_tab5.json"
