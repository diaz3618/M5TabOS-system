# Project target: without this, a fresh clone builds for the default ESP32.
CONFIG_IDF_TARGET="esp32c6"

# --- role: COPROCESSOR -------------------------------------------------------
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# WiFi: MUST stay on. This firmware replaces what currently makes the
# Tab5's WiFi work - turning this off would leave the device with no network.
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# The opaque P4 <-> C6 byte channel. This is what ESP-NOW talks over.
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y

# BLUETOOTH ON - this decision changed after MEASURING.
#
# The first version of this left BT out, for two reasons that didn't hold up:
#
#   "more headroom in the slot" - BT costs 259KB. With it, the image is
#   1.40MB of the default slot's 1.75MB, 24% free. Plenty of headroom.
#
#   "less new stuff at once" - the opposite, actually. The C6 is the Tab5's
#   ONLY radio, and M5Stack's firmware delivers BLE through it. Dropping BT
#   is not "less change", it's a REGRESSION: it removes a capability the
#   device had. Keeping it makes the new image closer to what's already
#   there, not further from it.
#
# The remaining risk - "what if M5Stack's real slot is smaller than
# 1.75MB?" - isn't really a risk: if the image doesn't fit, esp_ota_write
# fails partway through, and failing on write is safe (without the `end`
# call, the boot partition doesn't change). The worst case is a wasted
# attempt, and then we rebuild without BT.
#
# CONTROLLER_ONLY: the C6 only runs the controller; the stack (NimBLE/
# Bluedroid) lives on the P4 side, which is how esp_hosted was designed.
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y

# --- flash and partitions ----------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- SAFETY NET ---------------------------------------------------------------
# A new image boots in PENDING state. If it doesn't declare itself valid,
# the bootloader reverts to the previous one on the next boot.
#
# The BOOTLOADER does this check. Flashing over the cable carries our own
# (with this option); an OTA does not replace the bootloader. That's why
# app_main.c has a SECOND safety net, at the application level, armed only
# for an image that arrived over OTA.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- RADIO EXTRAS (contract v3): CSI, FTM, 802.15.4 --------------------------
# Each one sleeps until the P4 asks for it. Enabled here because reflashing
# the C6 is physical (Downloader): the flash carries everything that
# depends on the radio in one shot, and from then on evolution happens only
# on the P4 side. A CAPS bit only lights up if the flag was set.
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
# The C6's other radio (802.15.4). On the first test it took down WiFi
# (still associated, but the router stopped answering pings): COEXISTENCE
# was missing - app_main.c wasn't calling esp_coex_wifi_i154_enable(), and
# without it the RF arbiter doesn't account for 802.15.4. Fixed there; the
# module sleeps until the P4 asks for it. If it ever needs to come out:
# =n here, the module disappears and the C6_CAP_154 bit turns off.
CONFIG_IEEE802154_ENABLED=y

# The events task (sys_evt) runs the FTM report handler, which builds the
# message for the P4 on the stack (~300 B). The default 2304 was cutting it
# close.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584

# Crash snapshot in the 'coredump' partition (partitions.csv): survives a
# restart, and INFO tells the P4 one is saved.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
