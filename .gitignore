# Build outputs (ESP-IDF)
build/
build_v3/
build_m5burner*/
c6/build/
cardputer_teste/build/
managed_components/
c6/managed_components/
cardputer_teste/managed_components/
sdkconfig
sdkconfig.old
c6/sdkconfig
c6/sdkconfig.old
cardputer_teste/sdkconfig
cardputer_teste/sdkconfig.old

# The C6 lock file points esp_hosted to the local copy (override_path), using
# an absolute path specific to the machine: it is regenerated on the first build.
c6/dependencies.lock

# Machine-specific environment (see environment.sh) and editor configuration
environment.local.sh
.vscode/
.idea/

# Cache of images downloaded by tools/generate_emoji.py
.emoji_cache/

# Factory firmware of the C6 (from M5Stack - not redistributable)
c6/backup_fabrica_*.bin

# Data measured on the device
energia.csv
*.csv.bak

# System
.DS_Store
__pycache__/

# Personal terms searched by tools/publicar.sh before publishing
tools/privado.local.txt
.m5tabos-publico

# Firmware generated for the M5Burner (tools/m5burner.sh)
M5tabOS-*.bin
